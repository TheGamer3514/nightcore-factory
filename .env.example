# Copy to .env and fill in what you need. Every setting is optional.
# .env is git-ignored; real environment variables take priority over it.

# An email or project URL. MusicBrainz throttles anonymous clients, so without
# this the tag lookup degrades to iTunes-only. Use your own.
NIGHTCORE_CONTACT=you@example.com

# Handle burned into a corner of every frame. Empty string = no watermark.
NIGHTCORE_WATERMARK=@yourchannel

# Set to 0 to opt out of the Nightcore Network conventions (nightcore.com):
# no playlist tag lookup, no #playlist_ hashtag, no network blurb or link in
# the description. Songs are then never skipped for lacking a tag.
# NIGHTCORE_NETWORK=1

# Rendering
NIGHTCORE_THREADS=4
NIGHTCORE_POOL_JOBS=6
# NIGHTCORE_FONT_BOLD=/path/to/bold.ttf
# NIGHTCORE_FONT_REG=/path/to/regular.ttf

# Song sources. Spotify credentials are free from developer.spotify.com;
# without them the playlist is read from its embed page (capped at 100 tracks).
# SPOTIFY_PLAYLIST_ID=
# Used instead of SPOTIFY_PLAYLIST_ID from 1 Nov - 25 Dec / 24 - 31 Oct.
# SPOTIFY_CHRISTMAS_PLAYLIST_ID=
# SPOTIFY_HALLOWEEN_PLAYLIST_ID=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# APPLE_STOREFRONTS=us,gb,de,fr,es,br,jp,it,pl,mx
# SOUNDCHARTS_APP_ID=
# SOUNDCHARTS_API_KEY=

# YouTube quota, if Google has granted you an increase.
# YT_DAILY_BUDGET=10000
# YT_UPLOAD_COST=1600
